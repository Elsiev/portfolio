{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elsie-portfolio",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "routes": [
    { "pattern": "elsievanrooyen.co.za", "custom_domain": true },
    { "pattern": "www.elsievanrooyen.co.za", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    // The site is one static page with hash routes (#honeycode, #corleon,
    // #purr). Unknown paths, including links to the old React site
    // (/work/:slug), fall back to index.html.
    "not_found_handling": "single-page-application"
  }
}
